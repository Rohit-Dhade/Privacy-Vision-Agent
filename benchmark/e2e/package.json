{
  "name": "privacy-vision-agent-e2e",
  "private": true,
  "description": "Real-browser end-to-end tests for the Privacy-Vision-Agent extension.",
  "scripts": {
    "test": "node run-e2e.js",
    "demo": "node render-demo-artifacts.js",
    "test:headless-host": "xvfb-run -a --server-args=\"-screen 0 1280x900x24\" node run-e2e.js",
    "test:hostile": "node run-hostile.js",
    "perf": "node run-perf.js",
    "test:all": "node run-e2e.js && node run-hostile.js",
    "test:hostile:headless-host": "xvfb-run -a --server-args=\"-screen 0 1280x950x24\" node run-hostile.js",
    "perf:headless-host": "xvfb-run -a --server-args=\"-screen 0 1280x950x24\" node run-perf.js"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}