  {
    "id": "emergency-phone-not-generic-phone",
    "element": { "type": "input:tel", "ariaLabel": "Emergency Contact Number" },
    "expectedKey": "emergency_phone",
    "note": "Previously a documented limitation: fieldMatcher.js used to check HTML input type before label text, so a type=\"tel\" field short-circuited to the generic 'phone' key even when its label clearly said 'Emergency Contact'. Fixed this round by reordering matchElement() to try label-based exact/regex matches before falling back to the HTML-type check — this fixture is what proved the fix (it failed before the reorder, passes after)."
  },
